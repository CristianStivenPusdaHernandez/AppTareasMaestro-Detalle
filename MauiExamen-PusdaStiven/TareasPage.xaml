<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:MauiExamen_PusdaStiven.Models"
             x:Class="MauiExamen_PusdaStiven.TareasPage">

    <ScrollView>
        <VerticalStackLayout Padding="30" Spacing="15">

            <Label x:Name="lblCategoriaTitulo" FontSize="24" HorizontalOptions="Center" FontAttributes="Bold" TextColor="#512BD4" />

            <Entry x:Name="txtTitulo" Placeholder="Título de la tarea" />
            <Entry x:Name="txtDesc" Placeholder="Descripción corta" />

            <HorizontalStackLayout Spacing="10" HorizontalOptions="Center">
                <Label Text="¿Completada?" VerticalOptions="Center"/>
                <CheckBox x:Name="chkCompletada" Color="#512BD4" />
            </HorizontalStackLayout>

            <HorizontalStackLayout Spacing="10" HorizontalOptions="Center">
                <Button x:Name="btnGuardarTarea"
                        Text="Guardar Tarea" 
                        Clicked="OnGuardarTareaClicked" 
                        BackgroundColor="#512BD4" 
                        TextColor="White" 
                        WidthRequest="150" />

                <Button Text="Nuevo" 
                        Clicked="OnLimpiarClicked" 
                        BackgroundColor="Gray" 
                        TextColor="White" 
                        WidthRequest="100" />
            </HorizontalStackLayout>

            <BoxView HeightRequest="1" Color="LightGray" />

            <CollectionView x:Name="lstTareas" SelectionMode="None">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Tarea">
                        <Border Margin="0,5" Padding="10" BackgroundColor="#1e1e1e" Stroke="#333">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="5" />
                            </Border.StrokeShape>

                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnTareaTapped" CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>

                            <Grid ColumnDefinitions="Auto, *, Auto">
                                <CheckBox IsChecked="{Binding IsCompletada}" IsEnabled="False" Color="#512BD4" VerticalOptions="Center" />

                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Margin="15,0">
                                    <Label Text="{Binding Titulo}" FontAttributes="Bold" FontSize="18" TextColor="White" />
                                    <Label Text="{Binding Descripcion}" FontAttributes="Italic" TextColor="#BBB" FontSize="13" />
                                </VerticalStackLayout>

                                <Button Grid.Column="2" Text="Borrar" BackgroundColor="#D32F2F" TextColor="White" HeightRequest="40" Clicked="OnBorrarTareaClicked" CommandParameter="{Binding .}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>